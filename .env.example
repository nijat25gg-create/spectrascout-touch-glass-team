# Copy this file to .env and fill in the values. Never commit .env.
# When you add a new variable, add it here too, without its value.

# LLM (llm/ module, steps A and B)
ANTHROPIC_API_KEY=[API KEY needed]
MODEL=claude-sonnet-5-5
# optional: different models per step (fallback: MODEL)
MODEL_EXTRACT=claude-haiku-5-5
MODEL_REASON=claude-sonnet-5-5
# v0.3 attributes in step A (1 = on, 0 = v0.2 only)
EXTRACT_V03=1
# engine: b = method B ranks (default), ab = method A ranks with B attached, a = method A only
ENGINE=b
B_RANK_MODE=technical
# 1 = step A extracts the method B facts directly
EXTRACT_B=1
# 1 = llm.extract/explain return the examples from contracts/examples (no key, no cost). 0 = real Claude calls.
LLM_MOCK=1

# Backend, optional. Empty values keep the defaults: LOG_LEVEL=INFO, AI_TIMEOUT_SECONDS=30.
LOG_LEVEL=
AI_TIMEOUT_SECONDS=

# Jev cross-check (OpenRouter). Off unless JEV_LIVE=1. Jev never chooses the method.
JEV_LIVE=0
JEV_MODEL=
OPENROUTER_API_KEY=[API KEY needed]
