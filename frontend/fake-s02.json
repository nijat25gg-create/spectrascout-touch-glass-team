  "questions": [
    {
      "id": "q1",
      "text": "Is MIR ATR a fixed requirement, or is the goal a reliable ethanol reading in the control room? Which data sheet, fiber type and manufacturer does the 50 m claim come from, and do you already own an MIR analyzer or fiber?",
      "priority": "high",
      "why": "If the goal is the ethanol reading and not MIR itself, a method with long silica fibers such as Raman stays open. If MIR is fixed, the analyzer has to move next to the fermenter.",
      "parameter_id": "measurand",
      "feature": null,
      "attribute": null,
      "answer": null
    },
    {
      "id": "q2",
      "text": "What is the real cable route from the measurement point to the control room, and could the analyzer stand next to the fermenter with the result sent digitally to the control room?",
      "priority": "high",
      "why": "A short distance allows an MIR analyzer at the tank. A long distance restricts the choice to methods with long silica fibers.",
      "parameter_id": "distance_to_instrument",
      "feature": "distance_class",
      "attribute": null,
      "answer": null
    },
    {
      "id": "q3",
      "text": "Where would the probe go (fermenter wall, bypass loop, outlet line), is there a sampling port next to it, and are there gas bubbles, yeast or solids at that point?",
      "priority": "high",
      "why": "The measurement point decides between an immersion probe and optics through a window, and whether reference samples match the measured volume.",
      "parameter_id": "installation_point",
      "feature": null,
      "attribute": null,
      "answer": null
    },
    {
      "id": "q4",
      "text": "What ethanol concentration range, accuracy and response time must the measurement meet?",
      "priority": "medium",
      "why": "The range and accuracy decide whether a weak signal (Raman) or water-masked signal (NIR, MIR) is sufficient and how strict the success criterion must be.",
      "parameter_id": "required_accuracy",
      "feature": "accuracy_need",
      "attribute": "acceptance_criteria",
      "answer": null
    },
    {
      "id": "q5",
      "text": "Can deposits form at the probe window, and how is the line cleaned (CIP, temperature, chemicals)?",
      "priority": "medium",
      "why": "Fouling and cleaning chemicals can change the probe type, window material and the choice between contact and non-contact optics.",
      "parameter_id": "aggressiveness_fouling",
      "feature": "fouling_risk",
      "attribute": "fouling",
      "answer": null
    },
    {
      "id": "q6",
      "text": "What temperature, pressure and flow occur at the measurement point?",
