  "questions": [
    {
      "id": "q1",
      "text": "Wird die Frucht vor oder nach der Messstelle zugegeben, und wird in der Natur-Linie, der Frucht-Linie oder in beiden gemessen?",
      "priority": "high",
      "why": "Fruchtstücke und Farbstoffe ändern das optische Verhalten. Das entscheidet, ob die beiden Rezepturen eigene Sonden, Schnittstellen und Kalibrierungen brauchen, und beeinflusst das Fluoreszenzrisiko bei Raman.",
      "parameter_id": "installation_point",
      "feature": "phase",
      "attribute": null,
      "answer": null
    },
    {
      "id": "q2",
      "text": "Wo soll die Sonde eingebaut werden (Rohrleitung, Tank, Abfüllleitung), gibt es dort ein Fenster oder einen Stutzen, und gibt es eine Probenahmestelle direkt daneben?",
      "priority": "high",
      "why": "Die Messstelle entscheidet zwischen einer Sonde mit Produktkontakt und einer Optik durch ein Fenster, und ob Referenzproben dem entsprechen, was die Sonde sieht.",
      "parameter_id": "installation_point",
      "feature": null,
      "attribute": null,
      "answer": null
    },
    {
      "id": "q3",
      "text": "Mit welchen Labormethoden messen Sie Fett und Protein heute, mit welcher Messunsicherheit, und können Sie Proben beider Rezepturen über den gesamten Variationsbereich liefern?",
      "priority": "high",
      "why": "Referenzmethode und Unsicherheit legen fest, welche Genauigkeit eine Methode überhaupt zeigen kann, und Proben über den Rezepturbereich entscheiden, ob die Pilotstudie starten kann.",
      "parameter_id": "samples_available",
      "feature": null,
      "attribute": null,
      "answer": null
    },
    {
      "id": "q4",
      "text": "Welche Konzentrationsbereiche für Fett und Protein, welche Genauigkeit und welche Ansprechzeit muss die Messung erfüllen?",
      "priority": "medium",
      "why": "Geforderte Genauigkeit und Bereich entscheiden, ob eine schwächere Methode genügt und wie streng das Erfolgskriterium des Vergleichs sein muss.",
      "parameter_id": "required_accuracy",
      "feature": "accuracy_need",
      "attribute": "acceptance_criteria",
      "answer": null
    },
