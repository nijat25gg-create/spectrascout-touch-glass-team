      "title": "PremiseFlag",
      "type": "object"
    },
    "RejectedMethod": {
      "additionalProperties": false,
      "properties": {
        "method": {
          "enum": [
            "uv_vis",
            "nir",
            "mir",
            "raman",
            "fluorescence",
            "scattering"
          ],
          "title": "Method",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "rule_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Rule Id"
        },
        "blocker": {
          "description": "true = excluded by a hard rule, false = scored too low",
          "title": "Blocker",
          "type": "boolean"
        }
      },
      "required": [
        "method",
        "reason",
        "rule_id",
        "blocker"
      ],
      "title": "RejectedMethod",
      "type": "object"
    },
    "RowResult": {
      "additionalProperties": false,
      "description": "One catalog row (method x probe) after the gates (v0.3).",
      "properties": {
        "row": {
          "description": "Catalog id, e.g. K03",
          "title": "Row",
          "type": "string"
        },
        "method": {
          "enum": [
            "uv_vis",
            "nir",
            "mir",
            "raman",
            "fluorescence",
            "scattering"
          ],
          "title": "Method",
          "type": "string"
        },
        "technique": {
          "title": "Technique",
          "type": "string"
        },
        "status": {
          "enum": [
            "candidate",
            "needs_info",
            "excluded"
          ],
          "title": "Status",
          "type": "string"
        },
        "evidence": {
          "enum": [
            "application",
            "analogy",
            "physics_only",
            "none"
          ],
          "title": "Evidence",
          "type": "string"
        },
        "risks": {
          "description": "rule_id: effect for each risk",
          "items": {
            "type": "string"
          },
          "title": "Risks",
          "type": "array"
        },
        "reasons": {
          "description": "All fired rules on this row, rule_id: effect",
          "items": {
            "type": "string"
          },
          "title": "Reasons",
          "type": "array"
        }
      },
      "required": [
        "row",
        "method",
        "technique",
        "status",
        "evidence",
        "risks",
        "reasons"
      ],
      "title": "RowResult",
      "type": "object"
    },
    "ScoredMethod": {
      "additionalProperties": false,
      "properties": {
        "rank": {
          "title": "Rank",
          "type": "integer"
        },
        "method": {
          "enum": [
            "uv_vis",
            "nir",
            "mir",
            "raman",
            "fluorescence",
            "scattering"
          ],
          "title": "Method",
          "type": "string"
        },
        "mode": {
          "enum": [
            "transmission",
            "transflection",
            "atr",
            "diffuse_reflectance",
            "raman_backscatter",
            "fluorescence_emission",
            "combi_probe"
          ],
          "title": "Mode",
          "type": "string"
        },
        "spectral_range": {
          "title": "Spectral Range",
          "type": "string"
        },
        "fiber": {
          "title": "Fiber",
          "type": "string"
        },
        "probe": {
          "title": "Probe",
          "type": "string"
        },
        "score_total": {
          "title": "Score Total",
          "type": "number"
        },
        "scores": {
          "items": {
            "$ref": "#/$defs/CriterionScore"
          },
          "title": "Scores",
          "type": "array"
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ],
          "title": "Confidence",
          "type": "string"
        }
      },
      "required": [
        "rank",
        "method",
        "mode",
        "spectral_range",
        "fiber",
        "probe",
        "score_total",
        "scores",
        "confidence"
      ],
      "title": "ScoredMethod",
      "type": "object"
    },
    "Scoring": {
      "additionalProperties": false,
      "description": "C5 · engine -> Semyon. Filled from the gates engine (rules/gates.yaml); `assessment` carries its full result",
      "properties": {
        "rules_version": {
          "title": "Rules Version",
          "type": "string"
        },
        "ranked": {
          "description": "1-3 methods, rank 1 = best",
          "items": {
            "$ref": "#/$defs/ScoredMethod"
          },
          "title": "Ranked",
          "type": "array"
        },
        "rejected": {
          "items": {
            "$ref": "#/$defs/RejectedMethod"
          },
          "title": "Rejected",
          "type": "array"
        },
        "assessment": {
          "anyOf": [
            {
              "$ref": "#/$defs/GatesAssessment"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "v0.3: gates engine result (statuses, premises, questions, trace)"
        },
        "assessment_b": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "v0.4 optional: method B engine result (spec spectroscopy-rules 1.2): Cases, Q1/Q1b/Q2/Q3 scores 0-9, suitability 0-36, Q4, confidence, sensitivity, questions",
          "title": "Assessment B"
        }
      },
      "required": [
        "rules_version",
        "ranked",
        "rejected"
      ],
      "title": "Scoring",
      "type": "object"
    },
    "TraceStep": {
      "additionalProperties": false,
      "properties": {
        "step": {
          "enum": [
            "Q1",
            "Q2",
            "Q3",
            "Q4",
            "OUT"
          ],
          "title": "Step",
          "type": "string"
        },
        "rule_id": {
          "title": "Rule Id",
          "type": "string"
        },
        "target": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Row id, or null for case-level rules",
          "title": "Target"
        },
        "effect": {
          "title": "Effect",
          "type": "string"
        },
        "source": {
          "items": {
            "type": "string"
          },
          "title": "Source",
          "type": "array"
        }
      },
      "required": [
        "step",
        "rule_id",
        "target",
        "effect",
        "source"
      ],
      "title": "TraceStep",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "C6 · Semyon -> Nidzhat · call llm.explain(...)",
  "properties": {
    "case_id": {
      "title": "Case Id",
      "type": "string"
    },
    "language": {
      "enum": [
        "de",
        "en"
      ],
      "title": "Language",
      "type": "string"
    },
