    "GateQuestion": {
      "additionalProperties": false,
      "properties": {
        "attribute": {
          "enum": [
            "target_defined",
            "target_kind",
            "target_class",
            "targets_count",
            "quantitative",
            "reference_method",
            "reference_uncertainty",
            "acceptance_criteria",
            "concentration_range",
            "intended_use",
            "domain",
            "sample_form",
            "optical_density",
            "matrix_aqueous",
            "heterogeneous",
            "fluorophore",
            "chromophore",
            "matrix_fluorescence",
            "formulation_changed",
            "streams",
            "physical_variation",
            "temperature",
            "fouling",
            "distance",
            "link_confirmed",
            "existing_fiber",
            "gmp",
            "client_method",
            "reuse_calibration",
            "add_method_to_keep_calibration",
            "justification",
            "asks",
            "cited_evidence",
            "own_validation"
          ],
          "title": "Attribute",
          "type": "string"
        },
        "kind": {
          "enum": [
            "method",
            "plan",
            "lab_check"
          ],
          "title": "Kind",
          "type": "string"
        },
        "strength": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Share of answers that change the decision; null if forced or plan",
          "title": "Strength"
        },
        "forced": {
          "title": "Forced",
          "type": "boolean"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "attribute",
        "kind",
        "strength",
        "forced",
        "text"
      ],
      "title": "GateQuestion",
      "type": "object"
    },
    "GatesAssessment": {
      "additionalProperties": false,
      "description": "Output of engine.gates (v0.3), carried inside C5 as `assessment`.",
      "properties": {
        "rules_version": {
          "title": "Rules Version",
          "type": "string"
        },
        "decision_status": {
          "enum": [
            "provisional",
            "insufficient_information",
            "outside_scope"
          ],
          "title": "Decision Status",
          "type": "string"
        },
        "selected": {
          "description": "Top rows (at most 3), best first",
          "items": {
            "type": "string"
          },
          "title": "Selected",
          "type": "array"
        },
        "combinations": {
          "items": {
            "items": {
              "enum": [
                "uv_vis",
                "nir",
                "mir",
                "raman",
                "fluorescence",
                "scattering"
              ],
              "type": "string"
            },
            "type": "array"
          },
          "title": "Combinations",
          "type": "array"
        },
        "rows": {
          "description": "Every catalog row exactly once",
          "items": {
            "$ref": "#/$defs/RowResult"
          },
          "title": "Rows",
          "type": "array"
        },
        "premise_flags": {
          "items": {
            "$ref": "#/$defs/PremiseFlag"
          },
          "title": "Premise Flags",
          "type": "array"
        },
        "questions": {
          "description": "Method questions (strongest first), then plan questions",
          "items": {
            "$ref": "#/$defs/GateQuestion"
          },
          "title": "Questions",
          "type": "array"
        },
        "lab_checks": {
          "description": "Checked on samples in step 0 of the plan, not asked",
          "items": {
            "$ref": "#/$defs/GateQuestion"
          },
          "title": "Lab Checks",
          "type": "array"
        },
        "trace": {
          "items": {
            "$ref": "#/$defs/TraceStep"
          },
          "title": "Trace",
          "type": "array"
        },
        "ignored_inputs": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "v0.3: attribute names or values the engine ignored (outside the vocabulary)",
          "title": "Ignored Inputs"
        }
      },
      "required": [
        "rules_version",
        "decision_status",
        "selected",
        "combinations",
        "rows",
        "premise_flags",
        "questions",
        "lab_checks",
        "trace"
      ],
      "title": "GatesAssessment",
      "type": "object"
    },
    "Parameter": {
      "additionalProperties": false,
      "description": "Human-readable fact about the customer case (shown in the UI).",
      "properties": {
        "id": {
          "enum": [
            "measurand",
            "measurand_type",
            "matrix",
            "phase",
            "water_content",
            "concentration_range",
            "required_accuracy",
            "temperature",
            "pressure",
            "aggressiveness_fouling",
            "installation_point",
            "distance_to_instrument",
            "measurement_frequency",
            "reference_method",
            "samples_available",
            "regulatory"
          ],
          "title": "Id",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Free text value, null if unknown",
          "title": "Value"
        },
        "status": {
          "enum": [
            "known",
            "assumed",
            "unknown"
          ],
          "title": "Status",
          "type": "string"
        },
        "evidence_quote": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Exact words from the customer text, null if assumed or unknown",
          "title": "Evidence Quote"
        },
        "source": {
          "enum": [
            "customer_text",
            "llm_assumption",
            "expert_edit"
          ],
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "id",
        "value",
        "status",
        "evidence_quote",
        "source"
      ],
      "title": "Parameter",
      "type": "object"
    },
    "PremiseFlag": {
      "additionalProperties": false,
      "properties": {
        "rule_id": {
          "title": "Rule Id",
          "type": "string"
        },
        "verdict": {
          "enum": [
            "contradicted",
            "not_supported"
