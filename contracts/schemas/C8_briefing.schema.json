        "key": {
          "description": "Fact key from the method B catalog, e.g. 'Sample.physical_form'",
          "title": "Key",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "One allowed category (several targets: comma-separated), null if unknown",
          "title": "Value"
