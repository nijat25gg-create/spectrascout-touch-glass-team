    "AttributeFact": {
      "additionalProperties": false,
      "description": "One attribute of the analysis request (v0.3). known = the customer says it (quote verbatim);\nassumed = a safe inference (no quote); unknown = not said; conflicting = the text says two things.",
      "properties": {
        "name": {
          "enum": [
            "target_defined",
            "target_kind",
            "target_class",
            "targets_count",
            "quantitative",
            "reference_method",
            "reference_uncertainty",
            "acceptance_criteria",
            "concentration_range",
            "intended_use",
            "domain",
            "sample_form",
            "optical_density",
            "matrix_aqueous",
            "heterogeneous",
            "fluorophore",
            "chromophore",
            "matrix_fluorescence",
            "formulation_changed",
            "streams",
            "physical_variation",
            "temperature",
            "fouling",
            "distance",
            "link_confirmed",
            "existing_fiber",
            "gmp",
            "client_method",
            "reuse_calibration",
            "add_method_to_keep_calibration",
            "justification",
            "asks",
            "cited_evidence",
            "own_validation"
          ],
          "title": "Name",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "One value from the vocabulary of this attribute, null if unknown",
          "title": "Value"
        },
        "status": {
          "enum": [
            "known",
            "assumed",
            "unknown",
            "conflicting"
          ],
          "title": "Status",
          "type": "string"
        },
        "quote": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Exact words from the customer text, null if assumed or unknown",
          "title": "Quote"
        }
      },
      "required": [
        "name",
        "value",
        "status",
        "quote"
      ],
      "title": "AttributeFact",
      "type": "object"
    },
