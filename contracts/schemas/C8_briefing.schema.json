          "title": "Unit"
        },
        "status": {
          "enum": [
            "reported",
            "inferred",
            "unknown",
            "conflicting",
            "confirmed_experiment",
            "confirmed_expert"
          ],
          "title": "Status",
          "type": "string"
        },
        "quote": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Exact words from the customer text, null unless reported",
          "title": "Quote"
        },
        "source": {
