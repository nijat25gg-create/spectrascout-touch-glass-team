              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "client_text | step A inference | expert | experiment",
          "title": "Source"
        }
      },
      "required": [
        "key",
        "value",
        "status"
      ],
      "title": "FactB",
      "type": "object"
    },
