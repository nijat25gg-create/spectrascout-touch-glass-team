    "FactB": {
      "additionalProperties": false,
      "description": "One property for method B (v0.4): value + unit/category + source + status.\nkey = ER entity.field from rules/b/catalog_b.yaml. reported = the customer says it (quote verbatim);\ninferred = a safe inference (no quote); unknown = not said. Missing data is never filled.",
      "properties": {
        "key": {
          "description": "Fact key from the method B catalog, e.g. 'Sample.physical_form'",
          "title": "Key",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "One allowed category (several targets: comma-separated), null if unknown",
          "title": "Value"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Unit as the customer wrote it, or 'category'",
          "title": "Unit"
        },
        "status": {
          "enum": [
            "reported",
            "inferred",
            "unknown",
            "conflicting",
            "confirmed_experiment",
            "confirmed_expert"
          ],
          "title": "Status",
          "type": "string"
        },
        "quote": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Exact words from the customer text, null unless reported",
          "title": "Quote"
        },
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "client_text | step A inference | expert | experiment",
          "title": "Source"
        }
      },
      "required": [
        "key",
        "value",
        "status"
      ],
      "title": "FactB",
      "type": "object"
    },
